{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name — the site will be served at https://terrafound.<your-subdomain>.workers.dev
  "name": "terrafound",
  // Cloudflare account to deploy to (Dieulihn0920@gmail.com's Account — owns the trfound.com zone)
  "account_id": "e03f8085689dcb6ae35cb753d4d76c2e",
  "main": ".open-next/worker.js",
  // Custom domains — Cloudflare creates the DNS records and SSL certificates automatically
  "routes": [
    { "pattern": "trfound.com", "custom_domain": true },
    { "pattern": "www.trfound.com", "custom_domain": true }
  ],
  // The site is served on trfound.com only (no *.workers.dev URL on this account)
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "terrafound"
    }
  ],
  // Lets next/image resize/convert real photos (JPG/PNG → AVIF/WebP) via Cloudflare Images
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
